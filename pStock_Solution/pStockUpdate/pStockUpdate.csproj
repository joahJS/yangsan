<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>pStockUpdate</RootNamespace>
    <AssemblyName>pStockUpdate</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>pStockUpdate.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- zip 파일을 열어 폴더로 풀기 위한 프레임워크 어셈블리(.NET 4.8은 NuGet 없이 GAC 참조로 사용) -->
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <!-- .NET Framework 4.8에서는 System.Data.SqlClient가 프레임워크에 기본 포함되어 있어
       별도 NuGet 패키지가 필요 없습니다. -->

  <!-- DevExpress 18.2 로컬 설치 DLL 직접 참조.
       설치 경로나 버전이 다르면 아래 HintPath를 실제 경로로 수정하세요.
       기본 설치 경로: C:\Program Files (x86)\DevExpress 18.2\Components\Bin\Framework\ -->
  <ItemGroup>
    <Reference Include="DevExpress.Data.v18.2">
      <HintPath>C:\Program Files (x86)\DevExpress 18.2\Components\Bin\Framework\DevExpress.Data.v18.2.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Utils.v18.2">
      <HintPath>C:\Program Files (x86)\DevExpress 18.2\Components\Bin\Framework\DevExpress.Utils.v18.2.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Printing.v18.2.Core">
      <HintPath>C:\Program Files (x86)\DevExpress 18.2\Components\Bin\Framework\DevExpress.Printing.v18.2.Core.dll</HintPath>
    </Reference>
    <!-- XtraEditors 어셈블리 안에 DevExpress.XtraEditors와 DevExpress.XtraSplashScreen(SplashScreenManager)이 함께 들어있습니다. -->
    <Reference Include="DevExpress.XtraEditors.v18.2">
      <HintPath>C:\Program Files (x86)\DevExpress 18.2\Components\Bin\Framework\DevExpress.XtraEditors.v18.2.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
